{
  "manifest_version": 3,
  "name": "Importador Hourglass — Sessão",
  "version": "1.0.0",
  "description": "Envia a sessão do Hourglass para o Importador Hourglass local quando ele precisa.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://app.hourglass-app.com/*",
    "http://localhost:3434/*",
    "http://127.0.0.1:3434/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3434/*", "http://127.0.0.1:3434/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Importador Hourglass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "icons": {
    "16": "icones/icone-16.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  }
}
