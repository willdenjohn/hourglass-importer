{
  "name": "hourglass-importer",
  "version": "2.0.0",
  "description": "Imports monthly field service reports from a Microsoft Forms spreadsheet into Hourglass.",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node server.js --open",
    "cli": "node cli.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "main": "server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/willdenjohn/importador-hourglass.git"
  }
}
